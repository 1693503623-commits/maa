{
    "interface_version": 2,
    "name": "钢智星小助手",
    "description": "钢智星ai系统",
    "version": "1.0.2",
    "icon": "logo.ico",
    "controller": [
        {
            "name": "安卓手机",
            "type": "Adb",
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "默认资源",
            "path": [
                "./resource"
            ]
        }
    ],
    "group": [
        {
            "name": "main_flow",
            "label": "核心代付流程"
        }
    ],
    "agent": [
        {
            "child_exec": "C:\\Users\\kuriyama\\AppData\\Local\\Programs\\Python\\Python311\\python.exe",
            "child_args": [
                "-u",
                "../agent/main.py"
            ]
        }
    ],
    "task": [
        {
            "name": "1. 切换账号 (预留)",
            "entry": "切换账号节点",
            "group": [
                "main_flow"
            ]
        },
        {
            "name": "2. 主流程：自动比价与选品",
            "entry": "启动并等待",
            "group": [
                "main_flow"
            ],
            "option": [
                "商品名称输入",
                "目标店铺输入"
            ]
        },
        {
            "name": "3. 自动代付与通知",
            "entry": "购买",
            "group": [
                "main_flow"
            ],
            "option": [
                "通知方式选择",
                "代付人输入"
            ]
        },
        {
            "name": "4. 自动好评",
            "entry": "好评入口节点",
            "group": [
                "main_flow"
            ]
        },
        {
            "name": "5. 关闭应用",
            "entry": "关闭APP节点",
            "group": [
                "main_flow"
            ]
        }
    ],
    "option": {
        "通知方式选择": {
            "type": "select",
            "title": "代付通知方式",
            "cases": [
                {
                    "name": "直接保存手机截图",
                    "pipeline_override": {
                        "下单": {
                            "next": [
                                "保存截图"
                            ]
                        }
                    }
                },
                {
                    "name": "复制口令并发送微信 (需确保剪贴板同步)",
                    "pipeline_override": {
                        "下单": {
                            "next": [
                                "复制"
                            ]
                        }
                    }
                }
            ]
        },
        "商品名称输入": {
            "type": "input",
            "inputs": [
                {
                    "name": "商品名",
                    "default": "骨胶原软骨钙片",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "输入": {
                    "action": {
                        "param": {
                            "input_text": "{商品名}"
                        }
                    }
                }
            }
        },
        "目标店铺输入": {
            "type": "input",
            "inputs": [
                {
                    "name": "店铺名",
                    "default": "嘉旭",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "找到并点击商品": {
                    "recognition": {
                        "param": {
                            "expected": [
                                "{店铺名}"
                            ]
                        }
                    }
                }
            }
        },
        "代付人输入": {
            "type": "input",
            "inputs": [
                {
                    "name": "发送给谁",
                    "default": "Kanbara",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "发送脚本": {
                    "action": {
                        "param": {
                            "args": [
                                "{RESOURCE_DIR}/send_wechat.py",
                                "{发送给谁}"
                            ]
                        }
                    }
                }
            }
        }
    }
}
